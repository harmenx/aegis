.root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: row;
    padding: 16px 18px 12px 18px;
}

.column {
    flex-direction: column;
    height: 100%;
}

.left {
    width: 248px;
    border-right-width: 1px;
    border-right-color: rgba(170, 190, 214, 0.12);
    padding-right: 14px;
}

.right {
    width: 292px;
    border-left-width: 1px;
    border-left-color: rgba(170, 190, 214, 0.12);
    padding-left: 14px;
}

.center {
    flex-grow: 1;
    padding-left: 16px;
    padding-right: 16px;
}

.panel {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
    margin-bottom: 0;
}

.forks {
    padding-bottom: 14px;
    margin-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(170, 190, 214, 0.1);
}

.grow {
    flex-grow: 1;
}

.hole {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
}

.header {
    padding-bottom: 8px;
    margin-bottom: 4px;
}

.footer {
    flex-direction: row;
    align-items: flex-start;
    border-top-width: 1px;
    border-top-color: rgba(170, 190, 214, 0.12);
    padding-top: 10px;
}

.footer-card {
    flex-grow: 1;
    padding-right: 14px;
    margin-right: 14px;
    border-right-width: 1px;
    border-right-color: rgba(170, 190, 214, 0.1);
}

.wide {
    margin-right: 0;
    padding-right: 0;
    border-right-width: 0;
    flex-grow: 1.45;
}

.row {
    flex-direction: row;
    align-items: center;
}

.baseline {
    align-items: flex-end;
}

.spacer {
    flex-grow: 1;
}

.controls {
    padding-top: 8px;
}

.toggles {
    flex-direction: row;
    align-items: center;
}

.toggle {
    height: 16px;
    margin-right: 8px;
    margin-left: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 10px;
    color: rgba(150, 166, 186, 0.7);
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
    -unity-text-align: middle-left;
}

.toggle-on {
    color: rgb(226, 244, 255);
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.kicker {
    font-size: 11px;
    color: rgba(148, 164, 184, 0.78);
    margin-bottom: 2px;
    -unity-font-style: normal;
}

.figure {
    font-size: 42px;
    color: rgb(244, 247, 250);
    -unity-font-style: normal;
    margin-top: 0;
    margin-bottom: 0;
}

.accent {
    font-size: 46px;
    color: rgb(255, 214, 224);
}

.lines {
    font-size: 30px;
    color: rgb(48, 255, 138);
}

.deleted {
    font-size: 13px;
    color: rgba(150, 164, 180, 0.55);
    margin-left: 8px;
    margin-bottom: 4px;
}

.hint {
    font-size: 10px;
    color: rgba(124, 140, 160, 0.72);
    margin-top: 2px;
}

.clock {
    margin-top: 0;
}

.chip {
    font-size: 11px;
    color: rgb(120, 196, 255);
    margin-top: 2px;
    margin-bottom: 8px;
}

.keys {
    font-size: 10px;
    color: rgba(124, 140, 160, 0.55);
    margin-top: 2px;
    white-space: nowrap;
}

.list {
    flex-grow: 1;
}

.stream-panel {
    height: 100%;
}

.stream {
    flex-grow: 1;
    margin-top: 8px;
    overflow: hidden;
}

.contrib {
    height: 36px;
    width: 100%;
    margin-top: 8px;
    margin-bottom: 2px;
}

.reviewers {
    flex-direction: row;
    margin-top: 6px;
    overflow: hidden;
}

.vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.trend-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 7px;
    height: 24px;
}

.avatar {
    width: 22px;
    height: 22px;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
    flex-shrink: 0;
}

.avatar-letter {
    font-size: 10px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.reviewer {
    width: 46px;
    align-items: center;
    margin-right: 2px;
    flex-shrink: 0;
}

.reviewer-avatar {
    width: 18px;
    height: 18px;
    margin-bottom: 3px;
    align-items: center;
    justify-content: center;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

.trend-name {
    flex-grow: 1;
    font-size: 12px;
    color: rgb(232, 238, 244);
    overflow: hidden;
}

.reviewer-name {
    font-size: 8px;
    color: rgba(176, 190, 206, 0.8);
    -unity-text-align: upper-center;
    white-space: nowrap;
    overflow: hidden;
}

.stream-line {
    font-size: 10px;
    white-space: nowrap;
    overflow: hidden;
    margin-bottom: 2px;
    color: rgb(57, 229, 138);
}
