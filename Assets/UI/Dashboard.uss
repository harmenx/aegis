.root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: row;
    padding: 14px;
}

.column {
    flex-direction: column;
    height: 100%;
}

.left {
    width: 276px;
    margin-right: 12px;
}

.right {
    width: 360px;
    margin-left: 12px;
}

.center {
    flex-grow: 1;
}

.panel {
    background-color: rgba(5, 9, 16, 0.72);
    border-width: 1px;
    border-color: rgba(186, 206, 226, 0.14);
    padding: 10px 12px 8px 12px;
    margin-bottom: 8px;
}

.grow {
    flex-grow: 1;
}

.hole {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
}

.header {
    margin-bottom: 10px;
}

.footer {
    flex-direction: row;
    align-items: stretch;
}

.footer-card {
    flex-grow: 1;
    margin-right: 10px;
    margin-bottom: 0;
}

.wide {
    margin-right: 0;
    flex-grow: 1.3;
}

.row {
    flex-direction: row;
    align-items: center;
}

.baseline {
    align-items: flex-end;
}

.spacer {
    flex-grow: 1;
}

.toggles {
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
}

.toggle {
    height: 22px;
    margin-left: 6px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 1px;
    padding-bottom: 1px;
    font-size: 11px;
    color: rgba(186, 202, 220, 0.82);
    background-color: rgba(6, 12, 22, 0.55);
    background-image: none;
    border-width: 1px;
    border-color: rgba(186, 206, 232, 0.18);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    -unity-text-align: middle-center;
}

.toggle-on {
    color: rgb(236, 246, 255);
    border-color: rgba(130, 220, 255, 0.85);
    background-color: rgba(28, 78, 120, 0.55);
}

.kicker {
    font-size: 11px;
    color: rgba(154, 172, 194, 0.9);
    margin-bottom: 1px;
    -unity-font-style: normal;
}

.figure {
    font-size: 48px;
    color: rgb(255, 255, 255);
    -unity-font-style: normal;
    margin-top: 0;
    margin-bottom: 0;
}

.accent {
    color: rgb(255, 255, 255);
}

.lines {
    font-size: 34px;
    color: rgb(54, 255, 156);
}

.deleted {
    font-size: 16px;
    color: rgba(168, 180, 196, 0.72);
    margin-left: 10px;
    margin-bottom: 6px;
}

.hint {
    font-size: 10px;
    color: rgba(132, 148, 168, 0.8);
    margin-top: 2px;
}

.chip {
    font-size: 12px;
    color: rgb(150, 214, 255);
    margin-top: 4px;
    margin-bottom: 8px;
}

.keys {
    font-size: 10px;
    color: rgba(140, 156, 176, 0.7);
    margin-top: 2px;
    white-space: nowrap;
}

.list {
    flex-grow: 1;
}

.stream {
    flex-grow: 1;
    margin-top: 6px;
    overflow: hidden;
}

.contrib {
    height: 52px;
    margin-top: 8px;
    margin-bottom: 4px;
}

.reviewers {
    flex-direction: row;
    margin-top: 8px;
}

.vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.trend-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
    height: 20px;
}

.trend-index {
    width: 16px;
    font-size: 11px;
    color: rgba(150, 166, 186, 0.85);
}

.trend-dot {
    width: 14px;
    height: 14px;
    margin-right: 8px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.trend-name {
    width: 108px;
    font-size: 12px;
    color: rgb(236, 242, 248);
}

.trend-repo {
    flex-grow: 1;
    font-size: 11px;
    color: rgba(154, 170, 190, 0.78);
    overflow: hidden;
}

.stream-line {
    font-size: 10px;
    white-space: normal;
    margin-bottom: 3px;
    color: rgb(196, 208, 222);
}
