/* Gitmos overlay: Inter for chrome and figures, Plex Mono for the stream. */

.root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    padding: 12px;
    -unity-font-definition: url("../Fonts/Inter-Regular.ttf");
    color: rgb(204, 212, 224);
}

.grid {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.top {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.column {
    flex-direction: column;
}

.left {
    width: 312px;
}

.right {
    width: 352px;
    overflow: hidden;
}

.center {
    flex-grow: 1;
    padding-left: 22px;
    padding-right: 22px;
}

/* Panels are dark slabs, barely lifted off the stage, with no outline. */
.panel {
    background-color: rgba(17, 20, 26, 0.82);
    border-width: 0;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    padding: 18px 20px 16px 20px;
    margin-bottom: 8px;
}

.grow {
    flex-grow: 1;
}

.hole {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
}

.header {
    padding: 18px 0 0 0;
}

.footer {
    flex-direction: row;
    height: 158px;
    flex-shrink: 0;
}

.footer .panel {
    margin-bottom: 0;
    margin-right: 8px;
}

.lines-card {
    width: 312px;
    flex-shrink: 0;
}

.contrib-card {
    width: 392px;
    flex-shrink: 0;
}

.footer .wide {
    flex-grow: 1;
    margin-right: 0;
}

.row {
    flex-direction: row;
    align-items: center;
}

.spacer {
    flex-grow: 1;
}

/* Small line icons drawn in code. */
.icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
}

.kicker {
    font-size: 13px;
    -unity-font-definition: url("../Fonts/Inter-SemiBold.ttf");
    color: rgb(206, 214, 226);
    margin: 0;
    padding: 0;
}

.kicker.dim {
    color: rgba(120, 132, 150, 0.85);
}

.title {
    font-size: 13px;
}

.figure {
    font-size: 48px;
    color: rgb(148, 158, 182);
    margin: 10px 0 0 -2px;
    padding: 0;
    letter-spacing: -1px;
}

.accent {
    font-size: 50px;
    color: rgb(170, 160, 230);
}

.lines {
    font-size: 46px;
}

.hint {
    font-size: 10px;
    color: rgba(110, 122, 140, 0.9);
    margin: 4px 0 0 0;
    padding: 0;
}

.clock {
    margin-left: 10px;
    margin-top: 0;
}

.chip {
    font-size: 11px;
    color: rgb(255, 86, 110);
    margin: 0;
    padding: 0;
}

.trend-head {
    margin-top: 10px;
    margin-bottom: 14px;
}

.trend-head .hint {
    margin-top: 0;
}

.controls {
    flex-direction: row;
    align-items: center;
    height: 22px;
    margin-bottom: 10px;
}

.controls .icon {
    margin-right: 10px;
    margin-left: 8px;
}

.toggles {
    flex-direction: row;
    align-items: center;
}

.toggle {
    height: 20px;
    margin: 0 4px 0 0;
    padding: 0 8px 0 8px;
    font-size: 10px;
    color: rgba(130, 144, 164, 0.8);
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    -unity-text-align: middle-center;
    transition-duration: 0.2s;
}

.toggle:hover {
    color: rgb(220, 228, 240);
}

.toggle-on {
    color: rgb(230, 236, 246);
    background-color: rgba(190, 205, 230, 0.1);
}

.keys {
    font-size: 10px;
    color: rgba(110, 122, 140, 0.7);
    white-space: nowrap;
    margin-right: 10px;
}

.list {
    flex-grow: 1;
    overflow: hidden;
}

/* Code lines tabs */
.tabs-row {
    margin-top: 12px;
}

.tabs {
    flex-direction: row;
}

.tab {
    height: 18px;
    margin: 0 14px 0 0;
    padding: 0;
    font-size: 10px;
    color: rgba(110, 122, 140, 0.85);
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
    -unity-text-align: middle-left;
}

.tab-on {
    color: rgb(220, 228, 240);
}

.deleted {
    font-size: 10px;
    color: rgba(110, 122, 140, 0.85);
    margin: 0;
}

/* Trending developers */
.trend-row {
    flex-direction: row;
    align-items: center;
    height: 50px;
    margin-bottom: 6px;
    padding: 0 12px 0 6px;
    background-color: rgba(6, 8, 11, 0.55);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.trend-rank {
    width: 18px;
    font-size: 9px;
    color: rgba(110, 122, 140, 0.7);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.avatar {
    margin-right: 12px;
    flex-shrink: 0;
}

.trend-text {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.trend-name {
    font-size: 12px;
    color: rgb(214, 222, 234);
    margin: 0;
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
}

.trend-stats {
    font-size: 9px;
    color: rgba(110, 122, 140, 0.9);
    margin: 3px 0 0 0;
    padding: 0;
    white-space: nowrap;
}

.trend-repo {
    font-size: 10px;
    color: rgb(200, 208, 222);
    margin: 0 0 0 8px;
    padding: 0;
    max-width: 120px;
    overflow: hidden;
    white-space: nowrap;
    -unity-text-align: middle-right;
}

/* Data stream: newest on top, older entries fade out toward the bottom. */
.stream-head {
    margin-top: 4px;
    margin-bottom: 14px;
}

.stream-head .hint {
    margin-top: 0;
}

.stream-window {
    flex-grow: 1;
    overflow: hidden;
}

.stream {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
}

.stream-entry {
    height: 54px;
    font-size: 10px;
    -unity-font-definition: url("../Fonts/IBMPlexMono-Regular.ttf");
    white-space: nowrap;
    overflow: hidden;
    margin: 0;
    padding: 0;
    color: rgb(150, 164, 180);
}

/* Contribution graph */
.contrib {
    height: 56px;
    width: 352px;
    margin-top: 16px;
    margin-bottom: 6px;
}

.scale {
    flex-direction: row;
    justify-content: space-between;
    width: 352px;
}

/* Reviewers timeline */
.review-row {
    align-items: flex-start;
    flex-grow: 1;
}

.review-figure {
    width: 170px;
    flex-shrink: 0;
}

.timeline {
    flex-grow: 1;
    margin-top: 18px;
}

.reviewers {
    height: 44px;
    overflow: hidden;
}

.axis {
    position: absolute;
    left: 0;
    right: 0;
    top: 22px;
    height: 1px;
    background-color: rgba(190, 205, 230, 0.14);
}

.bubble {
    position: absolute;
    border-width: 0;
}

.review-repos {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 6px;
}

.review-repo {
    font-size: 9px;
    color: rgba(110, 122, 140, 0.85);
    margin: 0;
    padding: 0;
    white-space: nowrap;
}

/* Globe callouts */
.callout-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.callout {
    position: absolute;
    width: 0;
    height: 0;
    overflow: visible;
}

.callout-leader {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    background-color: rgba(220, 230, 255, 0.35);
}

.callout-dot {
    position: absolute;
    left: -2px;
    width: 5px;
    height: 5px;
    background-color: rgb(236, 244, 255);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.callout-title {
    position: absolute;
    top: -9px;
    font-size: 12px;
    color: rgb(236, 244, 255);
    white-space: nowrap;
    margin: 0;
    padding: 0;
}

.callout-detail {
    position: absolute;
    top: 7px;
    font-size: 9px;
    color: rgba(150, 166, 190, 0.85);
    white-space: nowrap;
    margin: 0;
    padding: 0;
}

.vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
